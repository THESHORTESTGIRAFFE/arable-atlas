GEMINI_API_KEY=your_google_gemini_api_key
# Choose a text-generation model available to your Gemini project.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENWEATHER_API_KEY=your_openweather_api_key
DATABASE_URL=sqlite:///agrimap.db
# Keep this stable so saved-field browser sessions survive restarts.
SECRET_KEY=replace_with_a_long_random_secret
# Soil maps are cached under instance/soil_cache by default.
# SOIL_CACHE_DIR=C:/path/to/soil_cache
# Use cached maps only (no WCS calls); weather and AI still need internet.
SOIL_OFFLINE=false
